{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:import-boundaries": "node scripts/check-import-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cards": "vitest run tests/realCards.matrix.test.js tests/realCards.host.integration.test.js tests/display-golden.test.js",
    "golden:refresh": "node ../scripts/golden-refresh.mjs && node ../scripts/real-card-fingerprints.mjs && node ../scripts/real-card-regex-inventory.mjs",
    "golden:check": "node ../scripts/golden-refresh.mjs --check && node ../scripts/real-card-fingerprints.mjs --check && node ../scripts/real-card-regex-inventory.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.2",
    "jquery": "3.7.1",
    "lodash": "4.17.21",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^3.2.7"
  }
}
